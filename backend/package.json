{
  "name": "stock-alert-backend",
  "version": "1.0.0",
  "description": "Backend for PWA Stock Availability Tracker",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/backend/src/index.js",
    "postinstall": "npx playwright install chromium --with-deps",
    "db:setup": "ts-node src/database/setup-db.ts",
    "db:reset": "ts-node src/database/setup-db.ts --reset"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.23.0",
    "node-cron": "^3.0.3",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
